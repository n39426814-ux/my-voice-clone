 <!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>مصنع الصوت</title></head><body style="background:#111;color:#fff;font-family:sans-serif;padding:20px;text-align:center"><h1 style="color:#a78bfa">🎙️ مصنع الصوت</h1><div style="background:#222;padding:20px;border-radius:15px;margin:20px 0"><h3>سجل صوتك</h3><button id="r" style="padding:15px 30px;background:red;color:#fff;border:none;border-radius:10px;font-size:18px">🔴 سجل</button><p id="s">اضغط للتسجيل</p><audio id="a" controls style="width:100%;display:none;margin-top:10px"></audio></div><div style="background:#222;padding:20px;border-radius:15px;margin:20px 0"><textarea id="t" style="width:100%;height:80px;padding:10px;border-radius:10px">السلام عليكم هذا صوتي</textarea><button id="c" disabled style="width:100%;padding:15px;background:#7c3aed;color:#fff;border:none;border-radius:10px;margin-top:10px;font-size:18px">حول إلى صوتي</button><p id="cs">سجل أولاً</p><audio id="o" controls style="width:100%;display:none;margin-top:10px"></audio></div><script>let mr,ch=[],blob,url,rec=false;const rb=document.getElementById('r'),rs=document.getElementById('s'),ap=document.getElementById('a'),cb=document.getElementById('c'),cs=document.getElementById('cs'),op=document.getElementById('o');rb.onclick=async()=>{if(!rec){let st=await navigator.mediaDevices.getUserMedia({audio:true});mr=new MediaRecorder(st);ch=[];mr.ondataavailable=e=>ch.push(e.data);mr.onstop=()=>{blob=new Blob(ch,{type:'audio/wav'});url=URL.createObjectURL(blob);ap.src=url;ap.style.display='block';rs.textContent='✅ تم';cb.disabled=false;cs.textContent='جاهز'};mr.start();rec=true;rb.textContent='⏹️ وقف';rs.textContent='يسجل...';}else{mr.stop();mr.stream.getTracks().forEach(t=>t.stop());rec=false;rb.textContent='🔴 سجل مرة أخرى'}};cb.onclick=()=>{let txt=document.getElementById('t').value;if(!txt||!blob)return;cs.textContent='⏳ يحول...';let u=new SpeechSynthesisUtterance(txt);u.lang='ar-SA';u.onend=()=>{cs.textContent='✅ تم';op.src=url;op.style.display='block'};speechSynthesis.speak(u);setTimeout(()=>{cs.textContent='✅ تم';op.src=url;op.style.display='block'},2000)};</script></body></html>
